# Sao chép file này thành .env. Không đưa .env hoặc secret thật lên Git.

DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@HOST.pooler.supabase.com:5432/postgres"
SESSION_SECRET="GENERATE_A_LONG_RANDOM_VALUE"
APP_ENV="development"
COOKIE_SECURE="false"
PORT="8088"

# Chỉ cần khi sử dụng chức năng ảnh đại diện qua Supabase Storage.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Checker mặc định dùng IP của server. Không lưu proxy trong database.
PROXY_MODE="direct"
PROXY_LIST=""
ROTATING_PROXY_URL=""
